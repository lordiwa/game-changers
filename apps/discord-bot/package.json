{
  "name": "@gamechangers/discord-bot",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "node --watch dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "deploy-commands": "node dist/scripts/deploy-commands.js"
  },
  "dependencies": {
    "discord.js": "14.26.3",
    "discord-api-types": "0.38.47",
    "firebase-admin": "13.8.0",
    "dotenv": "^16.0.0",
    "pino": "^9.0.0",
    "date-fns": "4.1.0",
    "@sentry/node": "10.50.0",
    "@gamechangers/functions-shared": "workspace:*"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vitest": "4.1.5",
    "@types/node": "^22.0.0"
  }
}
