# Firebase web SDK config — values from Firebase Console > Project Settings > Web app.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=gamechangers-prod.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=gamechangers-prod
VITE_FIREBASE_STORAGE_BUCKET=gamechangers-prod.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Sentry — DSN from Sentry Project Settings > Client Keys (DSN).
VITE_SENTRY_DSN=

# PostHog — self-hosted at https://posthog.gamechangers.gg per CLAUDE.md stack patterns.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://posthog.gamechangers.gg
