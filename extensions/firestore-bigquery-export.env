# Default parameters shared by all 8 firestore-bigquery-export installations.
# Per-collection params (COLLECTION_PATH, TABLE_ID) are set inline by scripts/setup-bq-export.sh.
#
# IMPORTANT: do NOT add a row for healthSamples here. ADR-009 prohibits exporting
# raw wearable samples to BigQuery — only the daily aggregate (healthDaily) leaves Firestore.

LOCATION=southamerica-east1
DATASET_ID=gw_analytics
WILDCARD_IDS=true
EXCLUDE_OLD_DATA=false
BACKUP_COLLECTION=
