{
  "name": "gamechangers",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "dev": "pnpm --filter @gamechangers/pwa dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "test:rules": "pnpm --filter @gamechangers/tests-rules test",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "emulators": "firebase emulators:start --only auth,firestore,functions,storage,hosting"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^10.2.1",
    "eslint-plugin-security": "^4.0.0",
    "eslint-plugin-vue": "^10.9.0",
    "firebase-tools": "^15.15.0",
    "globals": "^17.5.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.5"
  },
  "pnpm": {
    "overrides": {
      "posthog-js@<1.298.0": ">=1.298.0",
      "serialize-javascript@<6.0.3": ">=6.0.3",
      "@types/node": "22.19.17"
    }
  }
}
