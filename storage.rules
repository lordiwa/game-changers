rules_version = '2';

// GameChangers Storage Security Rules — deny-all baseline + Function-only writes.
// DSAR exports issued via signed URLs at issuance time; clients never read directly.
service firebase.storage {
  match /b/{bucket}/o {
    // DSAR ZIPs: written by the consent Function, read via signed URL only.
    match /dsar-exports/{uid}/{requestId} {
      allow read, write: if false;
    }

    // Avatars: public read (avatars surface in PublicProfile / cards / leaderboard);
    // owner-only write, max 2MB, image MIME only. Path convention is
    // /avatars/{uid}/main.{ext} (one canonical avatar per user, overwritten on update).
    match /avatars/{uid}/{file} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Default deny.
    match /{path=**} {
      allow read, write: if false;
    }
  }
}
