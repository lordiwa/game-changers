# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
.DS_Store
dist
dist-ssr
coverage
*.local
*.tsbuildinfo

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Vite
.vite
*.timestamp-*-*.mjs

# Vitest
__screenshots__/

# Cypress
/cypress/videos/
/cypress/screenshots/

.eslintcache

# Firebase
.firebase
firebase-debug.log
firestore-debug.log
ui-debug.log
*.local

# Env
.env
.env.*
!.env.example

# Fonts: do NOT ignore .woff2 in apps/pwa/public/fonts/ — they are committed
!apps/pwa/public/fonts/*.woff2

# TypeScript build artifacts (functions and packages)
functions/*/lib/
packages/*/lib/

# vue-tsc leaks .vue.d.ts/.js/.js.map files into src on failed builds — gitignore them
apps/pwa/src/**/*.vue.d.ts
apps/pwa/src/**/*.vue.js
apps/pwa/src/**/*.vue.js.map

# vue-tsc -b emits .d.ts/.js/.js.map alongside .ts sources in apps/pwa (composite project).
# Treat these as build output, not source.
apps/pwa/src/**/*.d.ts
apps/pwa/src/**/*.js
apps/pwa/src/**/*.js.map
# But keep hand-authored declaration files (none today; add allowlist if introduced)
!apps/pwa/src/vite-env.d.ts

# isolate-package output (per-codebase, regenerated each deploy)
functions/*/isolate/
packages/*/isolate/

# isolate-package output (generated per-codebase during firebase deploy)
functions/*/isolate/
packages/*/isolate/

# Claude Code agent worktrees and external tool data
.claude/worktrees/
.claire/
