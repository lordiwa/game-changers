{
  "name": "@gamechangers/functions-shared",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": ["lib"],
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc",
    "test": "echo 'shared module — no tests at this layer; rules-unit-testing covers consent helpers' && exit 0",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "firebase-functions": "7.2.5",
    "firebase-admin": "13.8.0",
    "@google-cloud/kms": "^5.4.0",
    "@sentry/node": "10.50.0",
    "@gamechangers/shared": "workspace:*"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  },
  "exports": {
    ".": { "types": "./lib/index.d.ts", "default": "./lib/index.js" },
    "./ConsentEnforcement": { "types": "./lib/ConsentEnforcement.d.ts", "default": "./lib/ConsentEnforcement.js" },
    "./hmac": { "types": "./lib/hmac.d.ts", "default": "./lib/hmac.js" },
    "./kms": { "types": "./lib/kms.d.ts", "default": "./lib/kms.js" },
    "./sentry": { "types": "./lib/sentry.d.ts", "default": "./lib/sentry.js" },
    "./types": { "types": "./lib/types.d.ts", "default": "./lib/types.js" },
    "./botAuth": { "types": "./lib/botAuth.d.ts", "default": "./lib/botAuth.js" }
  }
}
